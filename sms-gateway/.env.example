DATABASE_URL=postgresql://sms:sms@localhost:5432/sms
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
STARTING_CREDITS=100
ALLOW_DEV_TOPUP=true
MAX_RECIPIENTS=100
MAX_PARTS_PER_MESSAGE=10
LOW_BALANCE_THRESHOLD=100
PENDING_STALE_SECONDS=120
RECONCILE_INTERVAL_MS=30000
MOCK_LATENCY_MS=50
SEND_CONCURRENCY=10
RATE_LIMIT_PER_MINUTE=60
# Demo-only: lets any logged-in user change route failure rates via POST /api/demo/routes (for reviewers on a deployed link).
DEMO_CONTROLS=false
# Secret for GET /api/cron/reconcile (Vercel Cron). Leave empty to disable the endpoint.
CRON_SECRET=
